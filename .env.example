# Copie para .env.local e preencha:  cp .env.example .env.local
# Os arquivos .env e .env*.local são ignorados pelo git.

# Endereço do backend (compensar-core). Obrigatório.
# As rotas de src/pages/api repassam as chamadas para ele, do lado do servidor.
# Backend rodando na sua máquina (npm run dev ou docker compose):
BASE_API_URL=http://localhost:8080
# No docker compose, o próprio compose define BASE_API_URL=http://backend:8080.
